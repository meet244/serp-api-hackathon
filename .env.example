# Copy this file to .env and fill in the values. .env is git-ignored: never commit real keys.

# Required. Your SerpApi key: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Required: at least one LLM key. CFP Compass picks a fast, cheap model for the first key it finds:
#   ANTHROPIC_API_KEY -> anthropic:claude-haiku-5-5
#   GEMINI_API_KEY    -> google:gemini-flash-latest (a free Gemini API key works)
#   OPENAI_API_KEY    -> openai:gpt-4.1-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: any Pydantic AI model string, e.g. google:gemini-flash-latest or anthropic:claude-haiku-5-5
CFP_COMPASS_MODEL=

# Optional: where the SQLite response cache lives (default: .cache/cfp_compass.sqlite3)
CFP_COMPASS_CACHE=
